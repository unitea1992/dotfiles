#!/usr/bin/env bash
# dotfiles のファイルを、決まった場所へリンクする。前にあったファイルは <名前>.before-dotfiles に残す。
# 使い方：~/projects/dotfiles/install    （--dry-run で、するだけを表示）
set -euo pipefail
here="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
dry=0; [ "${1:-}" = --dry-run ] && dry=1

link() {
  local src="$here/$1" dst="$2"
  if [ "$(readlink -f -- "$dst" 2>/dev/null)" = "$src" ]; then echo "済み  $dst"; return; fi
  if [ "$dry" = 1 ]; then echo "張る  $dst -> $src"; return; fi
  mkdir -p -- "$(dirname -- "$dst")"
  if [ -e "$dst" ] || [ -L "$dst" ]; then mv -- "$dst" "$dst.before-dotfiles"; fi
  ln -s -- "$src" "$dst"
  echo "張った $dst -> $src"
}

link starship/starship.toml "$HOME/.config/starship.toml"
link git/hooks/pre-commit   "$HOME/.config/git/hooks/pre-commit"
link git/ignore             "$HOME/.config/git/ignore"
link mise/config.toml       "$HOME/.config/mise/config.toml"
link claude/rules/upstream-issues.md "$HOME/.claude/rules/upstream-issues.md"
# リポジトリが決めた版の CLI を、pnpm exec を付けずに呼ぶ入口（bin/project-bin）。
link bin/project-bin "$HOME/.local/bin/cf"
link bin/project-bin "$HOME/.local/bin/wrangler"
link bin/codex-update-shim "$HOME/.local/libexec/orca-codex-update-shim"

# ホームの下の決まったフォルダ（Desktop・Documents など）を英語の名前にする。OS を日本語で入れると
# 「デスクトップ」などになり、パスに日本語が混ざる。今の設定に英数字以外の名前があるときだけ動かす
# （英語のマシンや、置き場を手で変えたマシンの設定は触らない）。
xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"
if command -v xdg-user-dirs-update >/dev/null && [ -f "$xdg_config/user-dirs.dirs" ] \
   && grep -v '^#' "$xdg_config/user-dirs.dirs" | LC_ALL=C grep -q '[^ -~]'; then
  if [ "$dry" = 1 ]; then
    echo "する  フォルダの名前を英語にする（LANG=C xdg-user-dirs-update --force）"
  else
    LANG=C LC_ALL=C xdg-user-dirs-update --force
    echo C > "$xdg_config/user-dirs.locale"
    echo "フォルダの名前を英語にした。前の名前のフォルダは消していない（空なら手で消す）"
  fi
else
  echo "済み  フォルダの名前（英数字だけ、または設定なし）"
fi

cat <<MSG
残りは手で（マシンごとのファイルのため）：
  ~/.bashrc の最後に   . $here/bash/common.sh
  ~/.profile の最後に   . "$HOME/projects/dotfiles/bash/login.sh"
  ~/.zshenv の最後に   . "$HOME/projects/dotfiles/bash/login.sh" （zsh を使う場合）
  ~/.gitconfig に      [include] path = $here/git/config   （名前とメールは ~/.gitconfig に残す）
MSG
